{
	"name": "dedalus-cli",
	"version": "0.1.0",
	"description": "Controlplane API for Dedalus Cloud Services (DCS).",
	"license": "Apache-2.0",
	"author": "Dedalus",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dedalus-labs/dedalus-cli.git"
	},
	"man": [
		"./man/dedalus.1",
		"./man/dedalus-machines-list.1",
		"./man/dedalus-machines-create.1",
		"./man/dedalus-machines-retrieve.1",
		"./man/dedalus-machines-update.1",
		"./man/dedalus-machines-delete.1",
		"./man/dedalus-machines-watch.1",
		"./man/dedalus-machines-sleep.1",
		"./man/dedalus-machines-wake.1",
		"./man/dedalus-machines-network-retrieve.1",
		"./man/dedalus-machines-artifacts-list.1",
		"./man/dedalus-machines-artifacts-retrieve.1",
		"./man/dedalus-machines-artifacts-delete.1",
		"./man/dedalus-machines-ports-list.1",
		"./man/dedalus-machines-ports-create.1",
		"./man/dedalus-machines-ports-retrieve.1",
		"./man/dedalus-machines-ports-delete.1",
		"./man/dedalus-machines-ssh-list.1",
		"./man/dedalus-machines-ssh-create.1",
		"./man/dedalus-machines-ssh-retrieve.1",
		"./man/dedalus-machines-ssh-delete.1",
		"./man/dedalus-machines-executions-list.1",
		"./man/dedalus-machines-executions-create.1",
		"./man/dedalus-machines-executions-retrieve.1",
		"./man/dedalus-machines-executions-delete.1",
		"./man/dedalus-machines-executions-output.1",
		"./man/dedalus-machines-executions-events.1",
		"./man/dedalus-machines-terminals-list.1",
		"./man/dedalus-machines-terminals-create.1",
		"./man/dedalus-machines-terminals-retrieve.1",
		"./man/dedalus-machines-terminals-delete.1",
		"./man/dedalus-machines-terminals-connect.1",
		"./man/dedalus-networks-retrieve.1",
		"./man/dedalus-usage-retrieve.1",
		"./man/dedalus-usage-machine-compute.1",
		"./man/dedalus-usage-machine-storage.1",
		"./man/dedalus-completion.1"
	],
	"bin": {
		"dedalus": "./dist/esm/bin.js"
	},
	"files": [
		"dist",
		"api.md",
		"man",
		"SKILL.md"
	],
	"type": "module",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/esm/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/esm/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js",
			"default": "./dist/esm/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"public:check": "node --import tsx scripts/check-public.ts",
		"test:public": "node --import tsx --test tests/public-surface.test.ts",
		"pack:check": "node --import tsx scripts/check-package.ts",
		"build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cjs.json --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.tools.json",
		"test": "pnpm run build && node --import tsx scripts/run-tests.ts",
		"ci:generate": "hollywood generate 'ci/**/*.ts' --source-root ci --output .",
		"test:package": "node scripts/verify-preview-package.mjs"
	},
	"dependencies": {
		"ansis": "^4.3.0",
		"commander": "^14.0.3",
		"ws": "^8.18.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@dedalus-labs/hollywood": "0.0.5",
		"@types/node": "^20.17.0",
		"@types/ws": "^8.5.13",
		"oxfmt": "0.37.0",
		"tsx": "^4.20.0",
		"typescript": "^6.0.0",
		"zod": "4.3.6"
	},
	"packageManager": "pnpm@10.34.5"
}
